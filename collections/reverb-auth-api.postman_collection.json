          "name": "Obtain an authentication token",
          "request": {
            "name": "Obtain an authentication token",
            "description": {
              "content": "Exchanges an email and password for a Reverb auth token. The returned\ntoken is supplied on subsequent requests in the `X-Auth-Token` header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
